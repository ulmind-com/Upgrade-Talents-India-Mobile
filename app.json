{
  "expo": {
    "name": "Upgrade Talents India",
    "slug": "Upgrade-Talents-India-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/app-icon-centered-512.png",
    "scheme": "uti",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.upgradetalents.app",
      "associatedDomains": [
        "webcredentials:app.upgradetalentsindia.in"
      ],
      "icon": "./assets/Logo/app-icon-1024.png"
    },
    "android": {
      "package": "in.upgradetalents.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo/android-adaptive-foreground.png",
        "monochromeImage": "./assets/Logo/android-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upgrade Talents needs access to your photos to upload your ID proof and profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Upgrade Talents uses the camera to scan ticket and VIP pass QR codes at the gate.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-logo-white.png",
          "resizeMode": "contain",
          "imageWidth": 240
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F9862B",
          "largeIcon": "./assets/Logo/u-mark-512.png",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://event-management-backend-nijj.onrender.com",
      "google": {
        "webClientId": "618767397707-nfcedk5skrgfcm0g9djeshs3oniqcurn.apps.googleusercontent.com"
      },
      "firebase": {
        "apiKey": "AIzaSyBeSPoSBa_zHcfOjlVt7XmjzagohIzN6Wg",
        "projectId": "event-management-4fe6f"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fe3fd615-306b-4d63-9292-0df08f0b1407"
      }
    },
    "owner": "upgrade-talents-india"
  }
}
