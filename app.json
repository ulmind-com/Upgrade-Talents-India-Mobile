{
  "expo": {
    "name": "Upgrade Talents India",
    "slug": "Upgrade-Talents-India-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "uti",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.upgradetalents.app",
      "associatedDomains": ["webcredentials:app.upgradetalentsindia.in"]
    },
    "android": {
      "package": "in.upgradetalents.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Upgrade Talents needs access to your photos to upload your ID proof and profile picture."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Upgrade Talents uses the camera to scan ticket and VIP pass QR codes at the gate."
        }
      ],
      "expo-audio",
      "expo-sharing",
      "expo-web-browser",
      "expo-image",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://event-management-backend-nijj.onrender.com",
      "google": {
        "webClientId": "",
        "androidClientId": "",
        "iosClientId": ""
      }
    }
  }
}
